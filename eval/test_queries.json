          "Binary Search",
          "Suffix Array"
        ],
        "edge_type": "PREREQUISITE_OF"
      },
      "expected_behavior": "Returns the transitive prerequisite chain: Binary Search \u2192 Suffix Array.",
      "expected_route": "graph_hop"
    },
