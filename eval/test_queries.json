{
  "test_queries": [
    {
      "id": "Q1",
      "query": "How does a segment tree differ from a Fenwick tree for range queries?",
      "type": "graph-hop",
      "expected_retrieval": {
        "patterns": [
          "Segment Tree",
          "Fenwick Tree"
        ],
        "edge_type": "ALTERNATIVE_TO",
        "should_return_templates": true
      },
      "expected_behavior": "Returns both patterns, the ALTERNATIVE_TO tradeoff, and both C++ templates.",
      "expected_route": "graph_hop"
    },
    {
